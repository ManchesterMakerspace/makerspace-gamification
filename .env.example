# Use separate database users: source reads and Ledger-owned writes.
# Both URIs may point at the same cluster/database with different credentials.
MLAB_URI=mongodb://localhost:27017/makerauth?replicaSet=rs0
LEDGER_URI=mongodb://localhost:27017/makerauth?replicaSet=rs0
# Optional overrides; otherwise each URI's database is used, then makerauth.
# MLAB_DATABASE=makerauth
# LEDGER_DATABASE=makerauth
# Legacy MONGO_URI/MONGO_DATABASE remain fallbacks for existing installations.
# Prepare indexes/read models with ledger prepare-reads --verify before enabling.
# Python defaults to true; this example keeps the staged rollout on legacy reads.
LEDGER_OPTIMIZED_READS=false
# Opt-in aggregate command counts/documents/BSON reply bytes/latency; no bodies.
LEDGER_QUERY_METRICS=false
# Docker Compose host loopback port; choose another port if 3000 is in use.
# The container and Cloudflare Tunnel origin still use ledger-web:3000.
LEDGER_WEB_PORT=3000
SLACK_BOT_TOKEN=
# Enable Socket Mode in Slack too; create an app-level token with connections:write.
SLACK_SOCKET_MODE=false
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_BOT_USER_ID=
# Optional Slack user IDs excluded from Ledger opt-in, invitations, and channels.
# They can still receive ordinary kudos. Keep IDs in the quoted, comma-separated set form.
SLACKIDS_INELIGIBLE='{"U0123456789","U0345678901"}'
# Optional existing private channel IDs; the bot must already be a member.
LEDGER_CHANNELS={}
# Private, non-external staff review channel; invite The Ledger bot before enabling.
LEDGER_QUEST_REVIEW_CHANNEL_ID=
# Match the deployed model context window; tokenizer access is required.
LEDGER_QUEST_CONTEXT_LIMIT=8192
# Compose's private vLLM service. For a Python CLI on the same inference host,
# use http://localhost:8000/v1 (requires an explicitly published vLLM port).
LEDGER_LLM_BASE_URL=http://ledger-ai:8000/v1
LEDGER_LLM_MODEL=nvidia/Qwen3.8-27B-NVFP4
# Required by Compose; used as VLLM_API_KEY on the server and Bearer key by the bot.
LEDGER_LLM_API_KEY=
# Optional normal Google Doc link containing the complete XML/Markdown matrix.
# Blank uses the bundled matrix; workers fetch on startup and /ledger-admin reload-prompts.
LEDGER_PROMPT_MATRIX_DOC_URL=
# Optional OAuth bearer token with read access to a private Doc (Drive files.export).
# Leave blank for a Doc downloadable without sign-in. Never put secrets in the Doc.
LEDGER_PROMPT_MATRIX_GOOGLE_ACCESS_TOKEN=
# Optional JPEG archive for broken-ticket quests; OAuth token needs Drive file upload access.
# Kept separate from the Prompt Matrix read token and passed only to ledger-delivery.
LEDGER_TICKET_GOOGLE_ACCESS_TOKEN=
LEDGER_TICKET_GOOGLE_FOLDER_ID=
# Observation defaults on; member preferences opt out and false disables it deployment-wide.
# Suggestions are always audit-only; flags cannot authorize model-driven XP.
# AUDIT_ONLY is a compatibility setting; false still cannot activate awards or notifications.
LEDGER_OBSERVATION=true
LEDGER_OBSERVATION_AUDIT_ONLY=true
LEDGER_DEDUCTIONS=false
LEDGER_NOVEL_ANNOUNCEMENTS=false
LEDGER_WELCOMES=false
LEDGER_WELCOME_PROBABILITY=0.2
# Target: NVIDIA DGX Spark / GB10, Linux ARM64 + NVIDIA Container Toolkit.
# Pin tested image tags/digests for production; latest follows upstream releases.
VLLM_IMAGE=ghcr.io/timothystewart6/vllm-gb10:latest
VLLM_GPU_MEMORY_UTILIZATION=0.7
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=4
# Optional Hugging Face download token (not the vLLM API key).
HF_TOKEN=
# Remotely managed tunnel: published hostname -> http://ledger-web:3000.
# Replace LEDGER_HOST in slack-manifest.json with that public HTTPS hostname.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=makerspace-ledger

# Optional avatar deployment: docker compose --profile avatars up -d --build
# Pin to a tested vLLM-Omni image digest with Qwen-Image-2.1 support on GB10.
VLLM_OMNI_IMAGE=vllm/vllm-omni:latest

# Optional anomaly stack: COMPOSE_FILE=compose.anomaly.yaml (standalone), or
# compose.yaml:compose.anomaly.yaml on Linux (alongside The Ledger).
# Keep MLAB_URI read-only; provision exact find/changeStream grants from the
# generated build/anomaly/manifest.json. See docs/ANOMALY_BUILD.md.
ANOMALY_ENABLED=false
# Security findings remain private; alerts go only to currently authorized staff DMs.
ANOMALY_SECURITY_ENABLED=false
ANOMALY_SECURITY_ALERT_MODE=active
ANOMALY_SECURITY_DM_USER_IDS=[]
ANOMALY_SECURITY_RULES_PATH=/app/ledger/anomaly/security_rules.json
ANOMALY_SECURITY_EVALUATION_SECONDS=15
SLACK_CHANNEL_ANOMALY=ledger-audit
ANOMALY_SLACK_ALERT_MODE=shadow
ANOMALY_TIMEZONE=America/New_York
ANOMALY_MIN_COHORT_SIZE=5
ANOMALY_LAPSE_GRACE_DAYS=30
ANOMALY_EVENT_RETENTION_DAYS=90
ANOMALY_HISTORY_MONTHS=60
ANOMALY_BATCH_SIZE=500
ANOMALY_RECONCILE_SECONDS=780
ANOMALY_REFERENCE_DELAY=60
# Blank values reuse the existing LEDGER_LLM_* settings through Compose.
ANOMALY_LLM_BASE_URL=
ANOMALY_LLM_MODEL=
ANOMALY_LLM_API_KEY=
# Export these shell variables when overriding the mandatory rebuild source refresh.
ANOMALY_RAILS_REPOSITORY=https://github.com/ManchesterMakerspace/makerspace-rails-2026.git
ANOMALY_RAILS_REF=refs/heads/master
ANOMALY_RAILS_COMMIT=
ANOMALY_POSTGRES_IMAGE=postgres:17-alpine
ANOMALY_POSTGRES_PASSWORD=
# Use URL-safe random passwords or set a percent-encoded ANOMALY_DATABASE_URL.
ANOMALY_DB_PASSWORD=
ANOMALY_DATABASE_URL=
ANOMALY_REPORTING_PASSWORD=
METABASE_ANOMALY_DB_PASSWORD=
METABASE_RAW_DB_PASSWORD=
METABASE_ANOMALY_ENCRYPTION_KEY=
METABASE_RAW_ENCRYPTION_KEY=
METABASE_VERSION=v0.0.0-anomaly
METABASE_SOURCE_DIR=../metabase
METABASE_ANOMALY_PORT=3001
METABASE_RAW_PORT=3002
METABASE_ANOMALY_PUBLIC_URL=http://localhost:3001
METABASE_RAW_PUBLIC_URL=http://localhost:3002
ANOMALY_METABASE_CHAT_API_KEY=
ANOMALY_METABASE_CHART_API_KEY=
ANOMALY_METABASE_URL=http://metabase-anomaly:3000
ANOMALY_METABASE_RAW_URL=http://metabase-raw:3000
ANOMALY_REPORTING_DB_SSL=false
ANOMALY_REPORTING_DB_HOST=anomaly-postgres
ANOMALY_REPORTING_DB_PORT=5432
ANOMALY_REPORTING_DB_NAME=ledger_anomaly
ANOMALY_REPORTING_DB_USER=anomaly_reporter
# Optional remote reporting DB password; blank uses ANOMALY_REPORTING_PASSWORD.
ANOMALY_REPORTING_DB_PASSWORD=
ANOMALY_METABASE_PUBLIC_URL=
ANOMALY_MQTT_CLIENT_ID=ledger-anomaly
# One-shot bootstrap credentials; not passed to the steady-state service.
ANOMALY_METABASE_BOOTSTRAP_API_KEY=
ANOMALY_METABASE_RAW_API_KEY=
ANOMALY_SYSLOG_HOST=
ANOMALY_SYSLOG_PORT=6514
ANOMALY_SYSLOG_TRANSPORT=tls
ANOMALY_SYSLOG_CA_FILE=
LEDGER_AVATAR_RUNTIME_URL=http://ledger-image:8090
# Separate shared key, at least 24 characters. Keep off the public tunnel.
LEDGER_AVATAR_RUNTIME_KEY=
# Record the deployed checkpoint revision here; mirror it in the runtime command.
LEDGER_AVATAR_MODEL_REVISION=deployment-pinned
# Optional JSON argv override for local checkpoint / offload / quantization flags.
LEDGER_AVATAR_RUNTIME_COMMAND=
# Slack custom-profile field IDs; unset fields are omitted.
LEDGER_AVATAR_BIO_FIELD_ID=
LEDGER_AVATAR_INTERESTS_FIELD_ID=
LEDGER_AVATAR_CONTEXT_LIMIT=8192
