# Use separate database users: source reads and Ledger-owned writes.
# Both URIs may point at the same cluster/database with different credentials.
MLAB_URI=mongodb://localhost:27017/makerauth?replicaSet=rs0
LEDGER_URI=mongodb://localhost:27017/makerauth?replicaSet=rs0
# Optional overrides; otherwise each URI's database is used, then makerauth.
# MLAB_DATABASE=makerauth
# LEDGER_DATABASE=makerauth
# Legacy MONGO_URI/MONGO_DATABASE remain fallbacks for existing installations.
# Prepare indexes/read models with ledger prepare-reads --verify before enabling.
# Python defaults to true; this example keeps the staged rollout on legacy reads.
LEDGER_OPTIMIZED_READS=false
# Opt-in aggregate command counts/documents/BSON reply bytes/latency; no bodies.
LEDGER_QUERY_METRICS=false
# Docker Compose host loopback port; choose another port if 3000 is in use.
# The container and Cloudflare Tunnel origin still use ledger-web:3000.
LEDGER_WEB_PORT=3000
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_BOT_USER_ID=
# Optional existing private channel IDs; the bot must already be a member.
LEDGER_CHANNELS={}
# Private, non-external staff review channel; invite The Ledger bot before enabling.
LEDGER_QUEST_REVIEW_CHANNEL_ID=
# Match the deployed model context window; tokenizer access is required.
LEDGER_QUEST_CONTEXT_LIMIT=8192
# Compose's private vLLM service. For a Python CLI on the same inference host,
# use http://localhost:8000/v1 (requires an explicitly published vLLM port).
LEDGER_LLM_BASE_URL=http://ledger-ai:8000/v1
LEDGER_LLM_MODEL=nvidia/Qwen3.8-27B-NVFP4
# Required by Compose; used as VLLM_API_KEY on the server and Bearer key by the bot.
LEDGER_LLM_API_KEY=
# Optional normal Google Doc link containing the complete XML/Markdown matrix.
# Blank uses the bundled matrix; workers fetch on startup and /ledger-admin reload-prompts.
LEDGER_PROMPT_MATRIX_DOC_URL=
# Optional OAuth bearer token with read access to a private Doc (Drive files.export).
# Leave blank for a Doc downloadable without sign-in. Never put secrets in the Doc.
LEDGER_PROMPT_MATRIX_GOOGLE_ACCESS_TOKEN=
# Optional JPEG archive for broken-ticket quests; OAuth token needs Drive file upload access.
# Kept separate from the Prompt Matrix read token and passed only to ledger-delivery.
LEDGER_TICKET_GOOGLE_ACCESS_TOKEN=
LEDGER_TICKET_GOOGLE_FOLDER_ID=
# Observation defaults on; member preferences opt out and false disables it deployment-wide.
# Suggestions are always audit-only; flags cannot authorize model-driven XP.
# AUDIT_ONLY is a compatibility setting; false still cannot activate awards or notifications.
LEDGER_OBSERVATION=true
LEDGER_OBSERVATION_AUDIT_ONLY=true
LEDGER_DEDUCTIONS=false
LEDGER_NOVEL_ANNOUNCEMENTS=false
LEDGER_WELCOMES=false
LEDGER_WELCOME_PROBABILITY=0.2
# Target: NVIDIA DGX Spark / GB10, Linux ARM64 + NVIDIA Container Toolkit.
# Pin tested image tags/digests for production; latest follows upstream releases.
VLLM_IMAGE=ghcr.io/timothystewart6/vllm-gb10:latest
VLLM_GPU_MEMORY_UTILIZATION=0.7
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=4
# Optional Hugging Face download token (not the vLLM API key).
HF_TOKEN=
# Remotely managed tunnel: published hostname -> http://ledger-web:3000.
# Replace LEDGER_HOST in slack-manifest.json with that public HTTPS hostname.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=makerspace-ledger
